{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loft",
  "mainBinaryName": "loft-desktop",
  "version": "2.1.0",
  "identifier": "dev.xaria.loft",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "Claude Code background agents across your accounts",
    "longDescription": "One calm window for every Claude Code background agent on your machine, across as many Claude accounts as you use.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server.py": "loft/server.py",
      "../index.html": "loft/index.html",
      "../voice_worker.py": "loft/voice_worker.py",
      "../loft/": "loft/loft/",
      "../static/": "loft/static/",
      "../bin/loft": "loft/bin/loft"
    },
    "linux": {
      "deb": { "depends": ["python3"] },
      "rpm": { "depends": ["python3"] },
      "appimage": { "bundleMediaFramework": true }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
